{
  "name": "solace-starter-api",
  "version": "0.0.2",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "scripts": {
    "add:admin": "NODE_ENV=development medusa exec ./src/scripts/add-admin.ts",
    "build": "medusa build",
    "cloud:build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "pnpm run db:migrate && pnpm run db:sync-links && medusa start",
    "dev": "medusa develop",
    "db:init": "pnpm run db:migrate && pnpm run db:sync-links && pnpm run db:seed",
    "db:rollback": "medusa db:rollback",
    "db:sync-links": "medusa db:sync-links --execute-all",
    "db:migrate": "medusa db:migrate",
    "db:seed": "medusa exec ./src/scripts/seed.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.12.5",
    "@medusajs/admin-shared": "2.12.5",
    "@medusajs/cli": "2.12.5",
    "@medusajs/draft-order": "2.12.5",
    "@medusajs/dashboard": "2.12.5",
    "@medusajs/file-s3": "2.12.5",
    "@medusajs/framework": "2.12.5",
    "@medusajs/index": "2.12.5",
    "@medusajs/medusa": "2.12.5",
    "@medusajs/ui": "4.0.33",
    "@mikro-orm/knex": "6.4.16",
    "@mikro-orm/migrations": "6.4.16",
    "@mikro-orm/core": "6.4.16",
    "@react-email/components": "1.0.4",
    "@tanstack/react-query": "5.64.2",
    "@medusajs/icons": "2.12.5",
    "@medusajs/js-sdk": "2.12.5",
    "i18next": "^23.7.11",
    "jsonwebtoken": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^13.5.0",
    "resend": "^6.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.12.5",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.2"
}
