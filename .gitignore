# Dependencies
node_modules/

# Environment
# `.env*` must precede the negation, otherwise it re-matches `.env.example`
# and the example never gets committed. Order matters in gitignore.
.env
.env.local
.env.production
.env*
!.env.example
secrets*
start_log*
*.log

# Medusa / build outputs
.medusa/
dist/
build/
.cache/

# Database
medusa-db.sql

# Uploads
/uploads

# OS & IDE
.DS_Store
.idea/
.vscode/
*.log

# TypeScript
*.tsbuildinfo

# Test coverage
coverage/
