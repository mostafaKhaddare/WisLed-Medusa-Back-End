# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@your-postgres-host:5432/medusa

# Redis
REDIS_URL=redis://default:password@your-redis-host:6379

# Medusa runtime
MEDUSA_BACKEND_URL=https://your-backend.onrender.com
STORE_CORS=https://your-storefront.vercel.app
ADMIN_CORS=https://your-admin.vercel.app
AUTH_CORS=https://your-storefront.vercel.app
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-long-random-secret
NODE_ENV=production

# Optional integrations
STRIPE_API_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
DO_SPACE_URL=https://your-space.nyc3.digitaloceanspaces.com
DO_SPACE_ACCESS_KEY=replace-me
DO_SPACE_SECRET_KEY=replace-me
DO_SPACE_BUCKET=your-bucket
DO_SPACE_REGION=nyc3
DO_SPACE_ENDPOINT=https://nyc3.digitaloceanspaces.com
RESEND_API_KEY=replace-me
RESEND_FROM_EMAIL=no-reply@yourdomain.com
MEDUSA_FF_INDEX_ENGINE=false
