# =============================================================================
# WisLed Medusa v2 Backend — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL) — REQUIRED
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://medusa:medusa@localhost:5432/medusa-backend

# ---------------------------------------------------------------------------
# Redis — REQUIRED in production (used for sessions, event bus, caching, etc.)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# Optional: Use separate Redis instances for cache / locking (defaults to REDIS_URL)
# CACHE_REDIS_URL=redis://localhost:6379
# LOCKING_REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Security Secrets — REQUIRED (generate strong random values for production!)
# Run: openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=change_me_use_openssl_rand_hex_32
COOKIE_SECRET=change_me_use_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# CORS — REQUIRED (set to your actual frontend / admin URLs)
# Multiple origins: comma-separated, no trailing slash, no spaces
# ---------------------------------------------------------------------------
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:7000,http://localhost:7001,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:7001,http://localhost:9000

# ---------------------------------------------------------------------------
# Medusa Backend URL — REQUIRED in production
# The public URL of the deployed backend (used by Admin UI to make API calls)
# ---------------------------------------------------------------------------
MEDUSA_BACKEND_URL=http://localhost:9000

# ---------------------------------------------------------------------------
# Worker Mode — REQUIRED in production
#   "server" → handles HTTP API requests and serves the Admin dashboard
#   "worker" → handles background jobs, subscribers, scheduled tasks
#   "shared" → both in a single process (default for local development)
# ---------------------------------------------------------------------------
MEDUSA_WORKER_MODE=shared

# ---------------------------------------------------------------------------
# Admin Panel
#   Set to "true" on the *worker* deployment to skip building the Admin UI
# ---------------------------------------------------------------------------
DISABLE_MEDUSA_ADMIN=false

# ---------------------------------------------------------------------------
# Port — used by Railway and other PaaS providers (defaults to 9000)
# ---------------------------------------------------------------------------
PORT=9000

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
MEDUSA_FF_INDEX_ENGINE=false

# ---------------------------------------------------------------------------
# Stripe (optional — module is disabled when these are not set)
# ---------------------------------------------------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# DigitalOcean Spaces / S3 File Storage (optional)
# ---------------------------------------------------------------------------
DO_SPACE_URL=
DO_SPACE_ACCESS_KEY=
DO_SPACE_SECRET_KEY=
DO_SPACE_ENDPOINT=
DO_SPACE_BUCKET=
DO_SPACE_CDN=
DO_SPACE_REGION=

# ---------------------------------------------------------------------------
# Resend (optional — for transactional emails)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Test environment (integration tests only — not used in production)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medusa
DB_USER=medusa
DB_PASSWORD=medusa




























































